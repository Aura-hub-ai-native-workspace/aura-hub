{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aura:migration/providers-store.schema.json",
  "title": "PersistedProviderStore (~/.aura/providers.json)",
  "description": "Source: packages/ai-service/src/provider/credentialStore.ts:5-37. aes-256-gcm; key = sha256(seed + ':aura-provider-v2'); seed from env AURA_PROVIDER_SECRET or store.secret (random 32B hex, generated once). Python MUST read existing stores byte-compatibly (cryptography AESGCM, no AAD).",
  "type": "object",
  "additionalProperties": true,
  "required": ["credentials", "models", "health", "active", "activeModel"],
  "properties": {
    "secret": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Absent when AURA_PROVIDER_SECRET is set."
    },
    "credentials": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["encryptedKey", "iv", "tag", "fingerprint"],
        "properties": {
          "encryptedKey": { "type": "string", "description": "hex ciphertext" },
          "iv": { "type": "string", "description": "hex, 16 random bytes" },
          "tag": { "type": "string", "description": "hex GCM auth tag" },
          "fingerprint": { "type": "string", "description": "display fingerprint only" }
        }
      }
    },
    "models": { "type": "object" },
    "health": { "type": "object" },
    "active": { "type": ["string", "null"] },
    "activeModel": { "type": "string" }
  }
}
