node_modules
dist
dist-ssr
*.local

# AURA local artifacts (AI service bundle + knowledge indexes)
.aura
.aura-index
.aura-fullstack
.DS_Store
Thumbs.db
.env
.env.*
!.env.example

# Tauri / Rust
apps/desktop/src-tauri/target
apps/desktop/src-tauri/gen
# The packaged service is an esbuild output of packages/ai-service plus a staged
# copy of the TypeScript runtime, rebuilt by `npm run service:bundle` on every
# desktop build. Committing it would ship a second, silently-stale copy of the
# backend alongside its own source.
apps/desktop/src-tauri/resources/

# Editor
.vscode/*
!.vscode/extensions.json
.idea

# Logs
*.log
npm-debug.log*

# TypeScript incremental build cache
*.tsbuildinfo

# Coverage / test output
coverage
*.lcov

# Local AI/agent tooling state — never publish agent config or session state
.claude
.openharness

# graphify — keep the current graph (graphify-out/graph.json, GRAPH_REPORT.md,
# manifest.json, graph.html, .graphify_*) tracked as the live deliverable; its
# dated backup snapshots and AST/semantic cache are local-only and unbounded
# (a new ~2-5MB folder every day the tool runs) — never commit them.
graphify-out/cache/
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# UI approval-test screenshots (local evidence only)
scripts/.ui-*.png
# Hub verification screenshot (local evidence only)
scripts/.hub-*.png

# Release installers, renamed out of target/ by scripts/stage-release-artifacts.mjs.
# Build output — reproducible from a tagged commit, ~100 MB per platform, and
# distributed through CI artifacts and GitHub Releases rather than through git.
dist-release/
