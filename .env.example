# Copy to .env next to compose.yaml. Every value is optional.

# Host ports (always bound to 127.0.0.1).
AURA_ENVIRONMENT_PORT=4320
AI_PORT=4319

# Where the services look for Ollama. The default reaches Ollama on the host.
# With `--profile ollama`, use the bundled container instead:
# AURA_OLLAMA_BASE_URL=http://ollama:11434

# Recommended. When set, every backend route except /health requires the
# header `x-aura-instance-token: <token>`. Left empty, the backend accepts
# any request that reaches it. Generate one with:  openssl rand -hex 32
AURA_INSTANCE_TOKEN=

# Optional backend extras, comma-separated: multimodal, artifacts
AURA_EXTRAS=
