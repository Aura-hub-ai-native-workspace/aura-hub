{
  "name": "aura-hub",
  "private": true,
  "version": "0.1.2",
  "description": "AURA Hub — an AI Operating Environment. Application shell and architecture.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Aura-hub-ai-native-workspace/aura-hub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aura-hub-ai-native-workspace/aura-hub.git"
  },
  "bugs": {
    "url": "https://github.com/Aura-hub-ai-native-workspace/aura-hub/issues"
  },
  "keywords": [
    "ai",
    "developer-tools",
    "workflow-automation",
    "knowledge-graph",
    "monorepo",
    "tauri",
    "engineering-intelligence"
  ],
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @aura/desktop",
    "ai": "esbuild packages/ai-service/src/start.ts --bundle --platform=node --format=esm --external:typescript --outfile=.aura/ai-service.mjs && node .aura/ai-service.mjs",
    "build": "npm run build --workspace @aura/desktop",
    "preview": "npm run preview --workspace @aura/desktop",
    "tauri": "npm run tauri --workspace @aura/desktop",
    "service:bundle": "npm run service:bundle --workspace @aura/desktop",
    "desktop:dev": "npm run tauri --workspace @aura/desktop -- dev",
    "desktop:build": "NO_STRIP=true npm run tauri --workspace @aura/desktop -- build",
    "typecheck": "tsc -p packages/ai-service/tsconfig.json --noEmit && tsc -p packages/workflow/tsconfig.json --noEmit && tsc -b apps/desktop/tsconfig.json",
    "clean": "rimraf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist",
    "test:ui": "node scripts/ui-approval-test.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "0.21.5",
    "playwright-core": "^1.62.1",
    "rimraf": "^5.0.7",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.18"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
