{
  "name": "aura-hub",
  "private": true,
  "version": "0.1.0",
  "description": "AURA Hub — an AI Operating Environment. Application shell and architecture.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @aura/desktop",
    "ai": "esbuild packages/ai-service/src/start.ts --bundle --platform=node --format=esm --outfile=.aura/ai-service.mjs && node .aura/ai-service.mjs",
    "build": "npm run build --workspace @aura/desktop",
    "preview": "npm run preview --workspace @aura/desktop",
    "tauri": "npm run tauri --workspace @aura/desktop",
    "typecheck": "tsc -p packages/ai-service/tsconfig.json --noEmit && tsc -p apps/desktop/tsconfig.json --noEmit",
    "clean": "rimraf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "rimraf": "^5.0.7",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.18"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  },
  "dependencies": {
    "3d-force-graph": "^1.80.0",
    "three": "^0.185.1"
  }
}
