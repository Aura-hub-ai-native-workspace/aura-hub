{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AURA Hub",
  "version": "0.1.4",
  "identifier": "com.aura.hub",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": {
      "script": "npm run desktop:prepare",
      "wait": false
    },
    "beforeBuildCommand": "npm run desktop:prepare:build"
  },
  "app": {
    "windows": [
      {
        "title": "AURA Hub",
        "label": "main",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#ffffff",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["appimage", "deb"],
    "resources": ["resources/**/*"],
    "linux": {
      "deb": {
        "depends": ["nodejs"]
      }
    },
    "category": "DeveloperTool",
    "shortDescription": "AURA Hub — an AI Operating Environment",
    "longDescription": "AURA Hub is an AI-native operating environment: missions, a governed Capability Fabric, and a Connected Environment of real local tools. External tools stay external — AURA detects what is installed and routes every action through its policy, approval and audit path.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0NjlDNDlFNkMzRDYyOTcKUldTWFlqMXNuc1JwaEVzTWxiVFQ5SEN2dENqdnh4ckZPcFF5Mks4aU5zem15dmdBZE52ZklsaFEK",
      "endpoints": [
        "https://github.com/Aura-hub-ai-native-workspace/aura-hub/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
